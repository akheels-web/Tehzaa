# Tehzaa Celebrations Environment Variables Example
# Copy this file to .env.local and fill in your credentials

# Telegram Bot API Configuration (for real-time enquiry notifications)
# 1. Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Get your chat ID or group chat ID (use @userinfobot or invite bot to group)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
